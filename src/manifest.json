{
  "manifest_version": 3,
  "name": "CV Matcher",
  "version": "0.0.1",
  "version_name": "0.0.1 beta",
  "description": "Tailors your résumé to the job posting on the current page, so it matches what each company's ATS looks for. Uses Claude.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "CV Matcher", "default_popup": "popup.html" },
  "options_page": "popup.html"
}
